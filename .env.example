# Local dev default: a plain SQLite file, no Turso account needed to get started.
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# In production (Heroku config vars), point these at a Turso database instead:
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=<token from: turso db tokens create your-db-name>

PORT=5000
